{
  "name": "the-burger-house",
  "version": "2.7.0",
  "description": "Cardápio digital para hamburgueria com carrinho interativo, integração com WhatsApp e busca automática de endereço por CEP.",
  "author": "Felipe França",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n CSS,VITE \"npm:dev:css\" \"npm:dev:vite\"",
    "dev:css": "tailwindcss -i ./styles/style.css -o ./output.css --watch",
    "dev:vite": "vite",
    "build": "npm run build:css && vite build",
    "build:css": "tailwindcss -i ./styles/style.css -o ./output.css --minify",
    "preview": "vite preview",
    "serve:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run build && playwright test",
    "e2e:ci": "playwright test",
    "e2e:headed": "npm run build && playwright test --headed",
    "e2e:ui": "npm run build && playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^7.2.4",
    "vitest": "^4.1.6"
  }
}
