{
  "name": "the-burger-house",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:dev": "npm --prefix frontend run build -- --mode development",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm --prefix frontend run lint",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "test:owner:e2e": "playwright test --config playwright.owner.config.js",
    "test:owner:sqlite": "dotnet test backend/BurgerHouse.Api.Tests --filter FullyQualifiedName~AdminSecurityTests",
    "test:owner:browser-sqlite": "node tests/owner-browser-sqlite.mjs",
    "verify:build": "node scripts/verify-built-output.mjs",
    "verify:hosted": "node scripts/verify-hosted-preview.mjs",
    "test:admin": "npm --prefix owner-ui test && vitest run --config vitest.legacy.config.ts tests/product-classification.test.js tests/pagbank-checkout.test.js tests/payment-status-api.test.js",
    "test:legacy": "vitest run --config vitest.legacy.config.ts",
    "catalog:missing": "node scripts/admin/register-missing-products.mjs",
    "test:frontend": "npm --prefix frontend test",
    "build:owner": "npm --prefix owner-ui run build",
    "build:vercel": "npm run build && npm run build:owner && node scripts/package-official-frontend.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
