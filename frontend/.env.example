# Opcional. Origem do backend local, lida apenas pelo servidor Vite.
BURGER_DEV_API_ORIGIN=http://localhost:5041

# Opcional. Sem esta variável, o navegador usa o proxy /api de mesma origem.
VITE_API_BASE_URL=

# Opcional. Chave de navegador do MapTiler restrita por origem.
VITE_MAPTILER_KEY=

# OFF por padrão. ID público legítimo, consentimento e CSP explícita são necessários.
# Nunca coloque segredos nem dados pessoais nestas variáveis públicas de build.
VITE_ANALYTICS_ENABLED=false
VITE_GA4_MEASUREMENT_ID=

# Contato empresarial público, somente após verificação humana. Não é e-mail do Owner.
VITE_PUBLIC_WHATSAPP_VERIFIED=false
VITE_PUBLIC_WHATSAPP_NUMBER=
