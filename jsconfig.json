{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["vite/client", "mercadopago-sdk-js"]
  },
  "include": ["scripts/**/*.js", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist", "coverage", "tests"]
}
