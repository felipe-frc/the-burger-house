# Empacotamento Vercel local. Exporte esta variável no shell antes do build.
# Use esta origem reservada em verificações sem acesso a serviços externos.
BURGER_BUILD_API_ORIGIN=https://api.invalid

# API .NET, apenas no processo do servidor. O launcher Windows configura a sessão.
Database__Provider=PostgreSQL
# ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=55482;Database=tbh_portfolio_dev;Username=tbh_portfolio_dev_role;Search Path=public
# Forneça a senha via configuração privada do servidor ou arquivo de senhas PostgreSQL.
# Privacy__EncryptionKey exige 32 bytes aleatórios em Base64, estáveis por instalação.
# Deixe dados do provedor fora dos envs do navegador.
AZURE_TRANSLATION_ENABLED=false

# libpq para importação local. PGPASSWORD ou PGPASSFILE ficam fora do Git.
PGHOST=127.0.0.1
PGPORT=55482
PGDATABASE=tbh_portfolio_dev
PGUSER=tbh_portfolio_dev_role

# O launcher oficial injeta estas opções somente no processo local autorizado.
# Não colocar tokens PagBank ou segredos em variáveis VITE_*.
# Portfolio__Enabled=true
# PagBank__EnablePortfolioSandbox=true
# PagBank__BaseUrl=https://sandbox.api.pagseguro.com
# PagBank__RedirectUrl=https://127.0.0.1:55485/menu
# PagBank__AllowUnsignedSandboxWebhooks=false
